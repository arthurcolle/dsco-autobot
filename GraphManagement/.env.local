# Local Development Configuration
# Copy this to .env to use: cp .env.local .env

# ===============================
# Layer 1: Neo4j Wrapper Service
# ===============================
# Connection to your Neo4j Desktop instance
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=GraphInstance2025!
NEO4J_DATABASE=neo4j

# ===============================
# Layer 2: Graph Management API
# ===============================
# Point to the local Neo4j wrapper service (Layer 1)
BACKEND_URL=http://127.0.0.1:8001

# ===============================
# Authentication Configuration
# ===============================
# Auth mode: disabled | api_key | jwt
# For local development, use 'disabled' (no auth required)
# For production, use 'api_key' or 'jwt'
AUTH_MODE=disabled

# API Key Authentication (when AUTH_MODE=api_key)
# Generate keys with: python scripts/generate_auth_defaults.py
# AUTH_API_KEYS={"sk-dev-123": {"sub": "developer", "roles": ["developer"], "org": "acme"}}

# JWT Authentication (when AUTH_MODE=jwt)
# AUTH_JWT_SECRET=your-secret-key-here

# ===============================
# Logging & Debugging
# ===============================
LOG_LEVEL=INFO
DEBUG_ERRORS=1

# ===============================
# Embeddings (Optional)
# ===============================
# For vector search and semantic features
# JINA_API_KEY=jina_xxxxx
# OPENAI_API_KEY=sk-xxxxx
