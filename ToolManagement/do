#!/usr/bin/env bash
set -euo pipefail

DEFAULT_API_URL="https://tools.distributed.systems"
API_URL="${TOOLS_API_URL:-${TOOL_MANAGEMENT_API_URL:-$DEFAULT_API_URL}}"
TOKEN="${TOOLS_API_TOKEN:-${AUTH_TOKEN:-}}"

REQUEST_TIMEOUT="${TOOLS_API_TIMEOUT:-20}"
REQUEST_RETRIES="${TOOLS_API_RETRY:-1}"
VERBOSE=0
RAW=0
JQ_FILTER=""
PROFILE="${DO_PROFILE:-}"

load_profile() {
  local name="$1"
  local file="$HOME/.config/do/${name}.env"
  if [[ ! -f "$file" ]]; then
    echo "Profile not found: $file" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$file"
  API_URL="${TOOLS_API_URL:-${TOOL_MANAGEMENT_API_URL:-$API_URL}}"
  TOKEN="${TOOLS_API_TOKEN:-${AUTH_TOKEN:-$TOKEN}}"
  REQUEST_TIMEOUT="${TOOLS_API_TIMEOUT:-$REQUEST_TIMEOUT}"
  REQUEST_RETRIES="${TOOLS_API_RETRY:-$REQUEST_RETRIES}"
}

usage() {
  cat <<USAGE
Usage:
  ./do health
  ./do doctor
  ./do tools
  ./do search "<query>" [--limit <n>] [--backend <id>]
  ./do describe <tool>
  ./do exec <tool> [key=val ...]
  ./do batch <tool1> k=v -- <tool2> k=v ...
  ./do pipe <tool1> k=v -- <tool2> ... [--in k=v ...] [--stream]
  ./do fork <tool1> k=v -- <tool2> ... [--join merge|array|first] [--stream]
  ./do map <tool> --items <json|@file|-> [key=val ...]
  ./do reduce <tool> --items <json|@file|-> [--initial <json>] [key=val ...]
  ./do filter <predicate_tool> --items <json|@file|-> [key=val ...]
  ./do patterns
  ./do job submit <tool> [key=val ...] [--priority p0..p3] [--follow]
  ./do job status|watch|cancel <job_id>
  ./do job list [--status <s>] [--limit <n>]
  ./do analytics [overview|usage|failures|jobs|orchestration]
  ./do recommend "<objective>" [--intent <intent>] [--max-steps <n>] [key=val ...]
  ./do use-cases [query] [--domain <domain>] [--limit <n>] [--economic-only]
  ./do plan "<objective>" [--use-case <id>] [--template <name>] [key=val ...]
  ./do run "<objective>" [--intent <intent>] [--strategy <strategy>] [--use-case-first]
  ./do completion bash|zsh

Global options:
  --url <api_url>       Override API URL (default: $DEFAULT_API_URL)
  --token <bearer>      Set auth bearer token
  --profile <name>      Source ~/.config/do/<name>.env before running
  --timeout <seconds>   Default request timeout (default: ${REQUEST_TIMEOUT})
  --retry <count>       Retry count for transient errors (default: ${REQUEST_RETRIES})
  --jq <filter>         Filter successful JSON responses through jq
  --verbose             Print request/retry diagnostics to stderr
  --raw                 Print raw response body (no JSON pretty-print)
  -h, --help            Show this help

Env overrides:
  TOOLS_API_URL / TOOL_MANAGEMENT_API_URL
  TOOLS_API_TOKEN / AUTH_TOKEN
  TOOLS_API_TIMEOUT
  TOOLS_API_RETRY
  DO_PROFILE

Examples:
  ./do doctor
  ./do search "semantic embeddings" --limit 5
  ./do describe add
  ./do exec add a=2 b=3
  ./do batch add a=1 b=2 -- multiply a=3 b=4 -- uppercase text=hello
  ./do pipe search query=agents -- summarize --stream
  ./do fork search query=llms -- news topic=llms --join array
  ./do map uppercase --items '["alpha","beta","gamma"]'
  ./do job submit deep_research query="agent economics" --priority p0 --follow
  ./do job list --status running
  ./do analytics jobs
  ./do run "research AI startup landscape" --strategy parallel --use-case-first
