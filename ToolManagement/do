# ═════════════════════════════════════════════════════════════════════
# job submit|status|watch|cancel|list|analytics
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "job" || "$command" == "jobs" ]]; then
  if [[ $# -lt 1 ]]; then
    # bare "./do jobs" == "./do job list"
    subcommand="list"
  else
    subcommand="$1"
    shift
  fi

  case "$subcommand" in
    submit)
      if [[ $# -lt 1 ]]; then
        echo "Usage: ./do job submit <tool> [key=val ...] [--priority p0..p3] [--job-timeout <s>] [--dedupe-window <s>] [--convergence-key <k>] [--callback-url <url>] [--follow]" >&2
        exit 1
      fi
      tool="$1"
      shift

      priority="p1"
      job_timeout="300"
      dedupe_window="60"
      convergence_key=""
      callback_url=""
      follow=0
      kv_args=()

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --priority)
            require_value_flag "$1" "${2:-}"
            priority="$2"
            shift 2
            ;;
          --job-timeout)
            require_value_flag "$1" "${2:-}"
            job_timeout="$2"
            shift 2
            ;;
          --dedupe-window)
            require_value_flag "$1" "${2:-}"
            dedupe_window="$2"
            shift 2
            ;;
          --convergence-key)
            require_value_flag "$1" "${2:-}"
            convergence_key="$2"
            shift 2
            ;;
          --callback-url)
            require_value_flag "$1" "${2:-}"
            callback_url="$2"
            shift 2
            ;;
          --follow|-f)
            follow=1
            shift
            ;;
          *)
            kv_args+=("$1")
            shift
            ;;
        esac
      done

      if ! [[ "$job_timeout" =~ ^[0-9]+$ && "$dedupe_window" =~ ^[0-9]+$ ]]; then
        echo "--job-timeout and --dedupe-window must be integers (seconds)" >&2
        exit 1
      fi

      args_json="$(json_map_from_kv ${kv_args[@]+"${kv_args[@]}"})"
      payload="$(python3 - "$tool" "$args_json" "$job_timeout" "$priority" "$dedupe_window" "$convergence_key" "$callback_url" <<'PY'
import json
import sys

payload = {
    "tool": sys.argv[1],
    "arguments": json.loads(sys.argv[2]),
    "timeout": float(sys.argv[3]),
    "priority": sys.argv[4],
    "dedupe_window_seconds": int(sys.argv[5]),
}
if sys.argv[6]:
    payload["convergence_key"] = sys.argv[6]
if sys.argv[7]:
    payload["callback_url"] = sys.argv[7]

print(json.dumps(payload))
PY
)"

      call_api POST "/api/v1/jobs/submit" "$payload" 30
      if ! [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
        die_api "/api/v1/jobs/submit"
      fi

      if [[ "$follow" == "0" ]]; then
        print_body_stdout
        exit 0
      fi

      job_id="$(printf '%s' "$API_BODY" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read() or "{}")
    print(d.get("job_id") or d.get("id") or "", end="")
except Exception:
    print("", end="")
')"
      if [[ -z "$job_id" ]]; then
        print_body_stdout
        echo "Could not extract job_id to follow; showing submit response above." >&2
        exit 1
      fi

      echo "job_id: $job_id" >&2
      if sse_stream GET "/api/v1/jobs/${job_id}/stream"; then
        exit 0
      fi

      log "SSE unavailable; polling job status"
      while true; do
        call_api GET "/api/v1/jobs/${job_id}"
        if ! [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
          die_api "/api/v1/jobs/${job_id}"
        fi
        job_state="$(printf '%s' "$API_BODY" | python3 -c '
import json, sys
try:
    print(json.loads(sys.stdin.read() or "{}").get("status", ""), end="")
except Exception:
    print("", end="")
')"
        log "status=${job_state}"
        case "$job_state" in
          completed|failed|cancelled|canceled|error)
            print_body_stdout
            exit 0
            ;;
        esac
        sleep 2
      done
      ;;

    status|get)
      if [[ $# -lt 1 ]]; then
        echo "Usage: ./do job status <job_id>" >&2
        exit 1
      fi
      call_api GET "/api/v1/jobs/$1"
      ok_or_die "/api/v1/jobs/$1"
      ;;

    watch|stream|follow)
      if [[ $# -lt 1 ]]; then
        echo "Usage: ./do job watch <job_id>" >&2
        exit 1
      fi
      if ! sse_stream GET "/api/v1/jobs/$1/stream"; then
        log "SSE unavailable; showing current status"
        call_api GET "/api/v1/jobs/$1"
        ok_or_die "/api/v1/jobs/$1"
      fi
      ;;

    cancel)
      if [[ $# -lt 1 ]]; then
        echo "Usage: ./do job cancel <job_id>" >&2
        exit 1
      fi
      call_api POST "/api/v1/jobs/$1/cancel"
      ok_or_die "/api/v1/jobs/$1/cancel"
      ;;

    list)
      status_filter=""
      limit="50"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --status)
            require_value_flag "$1" "${2:-}"
            status_filter="$2"
            shift 2
            ;;
          --limit)
            require_value_flag "$1" "${2:-}"
            limit="$2"
            shift 2
            ;;
          *)
            echo "Unknown job list arg: $1" >&2
            exit 1
            ;;
        esac
      done
      if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
        echo "--limit must be an integer" >&2
        exit 1
      fi
      path="/api/v1/jobs/?limit=${limit}"
      [[ -n "$status_filter" ]] && path+="&status=$(urlencode "$status_filter")"
      call_api GET "$path"
      ok_or_die "$path"
      ;;

    analytics)
      call_api GET "/api/v1/jobs/analytics"
      ok_or_die "/api/v1/jobs/analytics"
      ;;

    *)
      echo "Unknown job subcommand: $subcommand (expected submit|status|watch|cancel|list|analytics)" >&2
      exit 1
      ;;
  esac
  exit 0
fi

