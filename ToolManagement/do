# ═════════════════════════════════════════════════════════════════════
# plan "<objective>" [--use-case <id>] [--template <name>] [key=val ...]
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "plan" ]]; then
  use_case_id=""
  domain=""
  template="default"
  execution=""
  max_parallel=""
  strict_placeholders=0
  discovery_limit="5"
  positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --use-case)
        require_value_flag "$1" "${2:-}"
        use_case_id="$2"
        shift 2
        ;;
      --domain)
        require_value_flag "$1" "${2:-}"
        domain="$2"
        shift 2
        ;;
      --template)
        require_value_flag "$1" "${2:-}"
        template="$2"
        shift 2
        ;;
      --execution)
        require_value_flag "$1" "${2:-}"
        execution="$2"
        shift 2
        ;;
      --max-parallel)
        require_value_flag "$1" "${2:-}"
        max_parallel="$2"
        shift 2
        ;;
      --strict)
        strict_placeholders=1
        shift
        ;;
      --no-strict)
        strict_placeholders=0
        shift
        ;;
      --discover-limit)
        require_value_flag "$1" "${2:-}"
        discovery_limit="$2"
        shift 2
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if ! [[ "$discovery_limit" =~ ^[0-9]+$ ]]; then
    echo "--discover-limit must be an integer" >&2
    exit 1
  fi
  if [[ -n "$max_parallel" && ! "$max_parallel" =~ ^[0-9]+$ ]]; then
    echo "--max-parallel must be an integer" >&2
    exit 1
  fi

  objective_parts=()
  override_args=()
  seen_override=0
  for token in "${positional[@]}"; do
    if [[ "$token" == *=* || "$seen_override" == "1" ]]; then
      override_args+=("$token")
      seen_override=1
    else
      objective_parts+=("$token")
    fi
  done

  objective="${objective_parts[*]}"
  if [[ -z "$objective" ]]; then
    echo 'Usage: ./do plan "<objective>" [--use-case <id>] [--template <name>] [key=val ...]' >&2
    exit 1
  fi

  if [[ -z "$use_case_id" ]]; then
    if discover_use_case "$objective" "$domain" "$discovery_limit"; then
      use_case_id="$DISCOVERED_USE_CASE_ID"
      log "Auto-selected use case: ${use_case_id}"
    else
      discover_rc=$?
      if [[ "$discover_rc" == "2" ]]; then
        die_api "$DISCOVER_USE_CASE_PATH"
      fi
      echo "Could not auto-discover a use case for objective: $objective" >&2
      echo "Provide one explicitly with --use-case <id> or inspect candidates via ./do use-cases \"$objective\"" >&2
      exit 1
    fi
  fi

  overrides_json="$(json_map_from_kv "${override_args[@]}")"
  payload="$(python3 - "$template" "$objective" "$overrides_json" "$strict_placeholders" "$execution" "$max_parallel" <<'PY'
import json
import sys

payload = {
    "template": sys.argv[1],
    "objective": sys.argv[2],
    "overrides": json.loads(sys.argv[3]),
    "strict_placeholders": bool(int(sys.argv[4])),
}
if sys.argv[5]:
    payload["execution"] = sys.argv[5]
if sys.argv[6]:
    payload["max_parallel"] = int(sys.argv[6])

print(json.dumps(payload))
PY
)"

  log "Planning use case '${use_case_id}'"
  call_api POST "/api/v1/use-cases/${use_case_id}/plan" "$payload" 90
  ok_or_die "/api/v1/use-cases/${use_case_id}/plan"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# run "<objective>"
# Smart route via:
#   1) optional use-case execute
#   2) orchestration execute
#   3) recommendation-driven single-tool fallback
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "run" ]]; then
  intent=""
  strategy="sequential"
  max_retries="2"
  use_case_id=""
  use_case_first=0
  domain=""
  template="default"
  execution=""
  max_parallel=""
  discovery_limit="5"
  positional=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent)
        require_value_flag "$1" "${2:-}"
        intent="$2"
        shift 2
        ;;
      --strategy)
        require_value_flag "$1" "${2:-}"
        strategy="$2"
        shift 2
        ;;
      --max-retries)
        require_value_flag "$1" "${2:-}"
        max_retries="$2"
        shift 2
        ;;
      --use-case)
        require_value_flag "$1" "${2:-}"
        use_case_id="$2"
        shift 2
        ;;
      --use-case-first)
        use_case_first=1
        shift
        ;;
      --domain)
        require_value_flag "$1" "${2:-}"
        domain="$2"
        shift 2
        ;;
      --template)
        require_value_flag "$1" "${2:-}"
        template="$2"
        shift 2
        ;;
      --execution)
        require_value_flag "$1" "${2:-}"
        execution="$2"
        shift 2
        ;;
      --max-parallel)
        require_value_flag "$1" "${2:-}"
        max_parallel="$2"
        shift 2
        ;;
      --discover-limit)
        require_value_flag "$1" "${2:-}"
        discovery_limit="$2"
        shift 2
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if ! [[ "$max_retries" =~ ^[0-9]+$ ]]; then
    echo "--max-retries must be an integer" >&2
    exit 1
  fi
  if [[ -n "$max_parallel" && ! "$max_parallel" =~ ^[0-9]+$ ]]; then
    echo "--max-parallel must be an integer" >&2
    exit 1
  fi
  if ! [[ "$discovery_limit" =~ ^[0-9]+$ ]]; then
    echo "--discover-limit must be an integer" >&2
    exit 1
  fi

  objective_parts=()
  data_args=()
  seen_data=0
  for token in "${positional[@]}"; do
    if [[ "$token" == *=* || "$seen_data" == "1" ]]; then
      data_args+=("$token")
      seen_data=1
    else
      objective_parts+=("$token")
    fi
  done

  objective="${objective_parts[*]}"
  if [[ -z "$objective" ]]; then
    echo 'Usage: ./do run "<objective>" [--intent <intent>] [--strategy <strategy>] [key=val ...]' >&2
    exit 1
  fi

  if [[ -z "$intent" ]]; then
    intent="$(infer_intent "$objective")"
  fi

  available_data_json="$(json_map_from_kv "${data_args[@]}")"

  if [[ "$use_case_first" == "1" || -n "$use_case_id" ]]; then
    if [[ -z "$use_case_id" ]]; then
      if discover_use_case "$objective" "$domain" "$discovery_limit"; then
        use_case_id="$DISCOVERED_USE_CASE_ID"
        log "Auto-selected use case for run: ${use_case_id}"
      else
        log "No use-case match found; continuing to orchestration"
      fi
    fi

    if [[ -n "$use_case_id" ]]; then
      use_case_payload="$(python3 - "$template" "$objective" "$available_data_json" "$execution" "$max_parallel" <<'PY'
import json
import sys

payload = {
    "template": sys.argv[1],
    "objective": sys.argv[2],
    "overrides": json.loads(sys.argv[3]),
    "strict_placeholders": False,
}
if sys.argv[4]:
    payload["execution"] = sys.argv[4]
if sys.argv[5]:
    payload["max_parallel"] = int(sys.argv[5])

print(json.dumps(payload))
PY
)"

      call_api POST "/api/v1/use-cases/${use_case_id}/execute" "$use_case_payload" 120
      if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
        print_body_stdout
        exit 0
      fi
      log "Use-case execution failed (status=${API_STATUS}); trying orchestration"
    fi
  fi

  orch_payload="$(python3 - "$intent" "$objective" "$strategy" "$max_retries" "$available_data_json" <<'PY'
import json
import sys
print(json.dumps({
    "intent": sys.argv[1],
    "query": sys.argv[2],
    "strategy": sys.argv[3],
    "max_retries": int(sys.argv[4]),
    "available_data": json.loads(sys.argv[5]),
}))
PY
)"

  call_api POST "/api/v1/orchestration/execute" "$orch_payload" 120
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    # Extract synthesized answer if present, otherwise show full response
    answer="$(printf '%s' "$API_BODY" | python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")

    # Top-level structured answer from LLM synthesis
    ans = data.get("answer")
    if ans:
        print(ans)
        conf = data.get("confidence")
        if conf:
            print(f"\nConfidence: {conf}")
        facts = data.get("key_facts", [])
        if facts:
            print("\nKey facts:")
            for f in facts:
                print(f"  - {f}")
        sources = data.get("sources", [])
        if sources:
            print("\nSources:")
            for s in sources:
                print(f"  - {s}")
        raise SystemExit(0)

    # Walk results backwards to find the best answer
    results = data.get("results", [])
    for r in reversed(results):
        if r.get("status") != "success":
            continue
        res = r.get("result")
        if isinstance(res, dict):
            if res.get("answer"):
                print(res["answer"], end="")
                raise SystemExit(0)
            synth = res.get("synthesis") or res.get("summary")
            if synth:
                print(synth, end="")
                raise SystemExit(0)
            findings = res.get("findings")
            if isinstance(findings, list) and findings:
                for f in findings:
                    if isinstance(f, dict):
                        print(f.get("content", f.get("text", json.dumps(f))))
                    else:
                        print(f)
                raise SystemExit(0)
        break
except SystemExit:
    raise
except Exception:
    pass
')"
    if [[ -n "$answer" ]]; then
      printf '%s\n' "$answer"
    else
      print_body_stdout
    fi
    exit 0
  fi

  log "Orchestration failed (status=${API_STATUS}); trying recommendation-driven fallback"
  rec_payload="$(python3 - "$objective" "$intent" <<'PY'
import json
import sys
print(json.dumps({
    "query": sys.argv[1],
    "intent": sys.argv[2],
    "limit": 1,
}))
PY
)"

  call_api POST "/api/v1/tools/recommendations" "$rec_payload" 45
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    top_tool="$(printf '%s' "$API_BODY" | python3 -c '
import json
import sys

try:
    payload = json.loads(sys.stdin.read() or "{}")
except Exception:
    print("", end="")
    raise SystemExit(0)

recs = payload.get("recommendations")
if isinstance(recs, list) and recs and isinstance(recs[0], dict):
    name = recs[0].get("name")
    print(str(name or ""), end="")
else:
    print("", end="")
')"

    if [[ -n "$top_tool" ]]; then
      fallback_payload="$(python3 - "$top_tool" "$objective" "$available_data_json" <<'PY'
import json
import sys

arguments = json.loads(sys.argv[3])
arguments.setdefault("query", sys.argv[2])
print(json.dumps({
    "tool": sys.argv[1],
    "arguments": arguments,
}))
PY
)"

      call_api POST "/api/v1/tools/execute" "$fallback_payload" 60
      if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
        print_body_stdout
        exit 0
      fi
    fi
  fi

  echo "Could not execute objective via use-case, orchestration, or recommendation fallback." >&2
  die_api "/api/v1/orchestration/execute"
fi

# ═════════════════════════════════════════════════════════════════════
# completion bash|zsh
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "completion" ]]; then
  shell_type="${1:-bash}"
  commands="health doctor tools search describe exec batch pipe fork map reduce filter patterns job analytics recommend use-cases plan run completion help"
  job_subs="submit status watch cancel list analytics"

  case "$shell_type" in
    bash)
      cat <<BASH
_do_complete() {
  local cur prev
  cur="\${COMP_WORDS[COMP_CWORD]}"
  prev="\${COMP_WORDS[COMP_CWORD-1]}"
  if [[ \$COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( \$(compgen -W "${commands}" -- "\$cur") )
  elif [[ "\$prev" == "job" || "\$prev" == "jobs" ]]; then
    COMPREPLY=( \$(compgen -W "${job_subs}" -- "\$cur") )
  elif [[ "\$prev" == "analytics" || "\$prev" == "stats" ]]; then
    COMPREPLY=( \$(compgen -W "overview usage failures jobs orchestration" -- "\$cur") )
  elif [[ "\$prev" == "completion" ]]; then
    COMPREPLY=( \$(compgen -W "bash zsh" -- "\$cur") )
  fi
}
complete -F _do_complete do ./do
BASH
      ;;
    zsh)
      cat <<ZSH
#compdef do
_do() {
  local -a commands job_subs
  commands=(${commands})
  job_subs=(${job_subs})
  if (( CURRENT == 2 )); then
    _describe 'command' commands
  elif [[ "\${words[2]}" == "job" || "\${words[2]}" == "jobs" ]] && (( CURRENT == 3 )); then
    _describe 'job subcommand' job_subs
  elif [[ "\${words[2]}" == "analytics" || "\${words[2]}" == "stats" ]] && (( CURRENT == 3 )); then
    local -a targets; targets=(overview usage failures jobs orchestration)
    _describe 'analytics target' targets
  fi
}
compdef _do do ./do
ZSH
      ;;
    *)
      echo "Usage: ./do completion bash|zsh" >&2
      exit 1
      ;;
  esac
  exit 0
fi

