USAGE
}

log() {
  if [[ "$VERBOSE" == "1" ]]; then
    printf '[do] %s\n' "$*" >&2
  fi
}

pretty_json() {
  if command -v jq >/dev/null 2>&1; then
    jq .
  else
    python3 -m json.tool 2>/dev/null || cat
  fi
}

print_body_stdout() {
  if [[ -n "$JQ_FILTER" ]]; then
    printf '%s\n' "$API_BODY" | jq "$JQ_FILTER"
  elif [[ "$RAW" == "1" ]]; then
    printf '%s\n' "$API_BODY"
  else
    printf '%s\n' "$API_BODY" | pretty_json
  fi
}

print_body_stderr() {
  if [[ "$RAW" == "1" ]]; then
    printf '%s\n' "$API_BODY" >&2
  else
    printf '%s\n' "$API_BODY" | pretty_json >&2
  fi
}

API_STATUS=""
API_BODY=""
API_ERROR=""
DISCOVER_USE_CASE_PATH=""
DISCOVERED_USE_CASE_ID=""

# call_api METHOD PATH [BODY] [TIMEOUT_SECONDS]
call_api() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local timeout="${4:-$REQUEST_TIMEOUT}"

  local max_attempts=$((REQUEST_RETRIES + 1))
  local attempt rc retryable sleep_seconds

  API_STATUS=""
  API_BODY=""
  API_ERROR=""

  for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    log "HTTP ${method} ${path} (attempt ${attempt}/${max_attempts}, timeout=${timeout}s)"

    local -a args=(
      -sS --connect-timeout 5 --max-time "$timeout"
      -X "$method" "$API_URL$path"
      -H "content-type: application/json"
    )
    [[ -n "$TOKEN" ]] && args+=(-H "authorization: Bearer $TOKEN")
    [[ -n "$body" ]] && args+=(-d "$body")

    local tmp err
    tmp="$(mktemp)"
    err="$(mktemp)"

    set +e
    API_STATUS="$(curl "${args[@]}" -o "$tmp" -w "%{http_code}" 2>"$err")"
    rc=$?
    set -e

    API_BODY="$(cat "$tmp")"
    API_ERROR="$(cat "$err")"
    rm -f "$tmp" "$err"

    if [[ $rc -ne 0 && -z "$API_BODY" ]]; then
      API_STATUS="000"
      API_BODY='{"error":"Connection failed or timed out"}'
    fi

    retryable=0
    if (( attempt < max_attempts )); then
      if [[ $rc -ne 0 ]]; then
        retryable=1
      elif [[ "$API_STATUS" == "429" || "$API_STATUS" =~ ^5[0-9][0-9]$ ]]; then
        retryable=1
      fi
    fi

    if (( retryable == 1 )); then
      sleep_seconds=$((attempt < 8 ? attempt : 8))
      log "Transient failure (status=${API_STATUS}); retrying in ${sleep_seconds}s"
      sleep "$sleep_seconds"
      continue
    fi

    return 0
  done
}

die_api() {
  local path="$1"
  echo "HTTP ${API_STATUS:-000} from $API_URL$path" >&2
  if [[ "$VERBOSE" == "1" && -n "$API_ERROR" ]]; then
    echo "$API_ERROR" >&2
  fi
  [[ -n "$API_BODY" ]] && print_body_stderr
  exit 1
}

ok_or_die() {
  local path="$1"
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    print_body_stdout
  else
    die_api "$path"
  fi
}

urlencode() {
  python3 - "$1" <<'PY'
import sys
from urllib.parse import quote
print(quote(sys.argv[1]))
PY
}

# sse_stream METHOD PATH [BODY] — stream SSE events, pretty-printing each data payload.
# Returns curl's exit code; caller decides whether to fall back.
sse_stream() {
  local method="$1"
  local path="$2"
  local body="${3:-}"

  local -a args=(
    -N -sS --connect-timeout 5
    -X "$method" "$API_URL$path"
    -H "accept: text/event-stream"
    -H "content-type: application/json"
  )
  [[ -n "$TOKEN" ]] && args+=(-H "authorization: Bearer $TOKEN")
  [[ -n "$body" ]] && args+=(-d "$body")

  log "SSE ${method} ${path}"
  local rc=0
  set +e
  curl "${args[@]}" | python3 -u -c '
import json, sys
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line.startswith("data:"):
        continue
    payload = line[5:].strip()
    if not payload:
        continue
    try:
        event = json.loads(payload)
    except Exception:
        print(payload, flush=True)
        continue
    etype = event.get("event_type") or event.get("type") or event.get("event") or "event"
    compact = {k: v for k, v in event.items()
               if k not in ("event_type", "type", "event") and v not in (None, "", [], {})}
    print(f"[{etype}] " + json.dumps(compact, default=str), flush=True)
'
  rc=${PIPESTATUS[0]}
  set -e
  return "$rc"
}

# parse_tool_groups "$@" — split "tool k=v k=v -- tool2 k=v" argv into
# {"tools": [...], "arguments": [{...}, ...]} with JSON-coerced values.
parse_tool_groups() {
  python3 -c "
import json, sys

groups, current = [], []
for tok in sys.argv[1:]:
    if tok == '--':
        if current:
            groups.append(current)
        current = []
    else:
        current.append(tok)
if current:
    groups.append(current)

if not groups:
    print('No tools given', file=sys.stderr)
    sys.exit(1)

def coerce(raw):
    try:
        return json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        for cast in (int, float):
            try:
                return cast(raw)
            except ValueError:
                pass
        return raw

tools, arguments = [], []
for g in groups:
    tools.append(g[0])
    inputs = {}
    for arg in g[1:]:
        if '=' not in arg:
            print(f'Bad arg (expected key=val): {arg}', file=sys.stderr)
            sys.exit(1)
        k, v = arg.split('=', 1)
        inputs[k] = coerce(v)
    arguments.append(inputs)

print(json.dumps({'tools': tools, 'arguments': arguments}))
" "$@"
}

# resolve_items SPEC — accept an inline JSON array, @file, or '-' for stdin.
resolve_items() {
  local spec="$1"
  local raw
  if [[ "$spec" == "-" ]]; then
    raw="$(cat)"
  elif [[ "$spec" == @* ]]; then
    raw="$(cat "${spec:1}")"
  else
    raw="$spec"
  fi
  python3 - "$raw" <<'PY'
import json
import sys

raw = sys.argv[1].strip()
try:
    items = json.loads(raw)
except Exception:
    # Fall back: newline-separated plain values
    items = [line for line in raw.splitlines() if line.strip()]
if not isinstance(items, list):
    items = [items]
print(json.dumps(items))
PY
}

infer_intent() {
  python3 - "$1" <<'PY'
import sys
obj = sys.argv[1].lower()
if any(w in obj for w in ['remember', 'save', 'store', 'note']):
    print('remember')
elif any(w in obj for w in ['notify', 'publish', 'post', 'send']):
    print('publish')
elif any(w in obj for w in ['transform', 'convert', 'change', 'add', 'subtract', 'multiply', 'divide', 'uppercase', 'lowercase']):
    print('transform')
elif any(w in obj for w in ['analyze', 'count', 'compare', 'check', 'summarize', 'synthesize']):
    print('analyze')
else:
    print('research')
PY
}

json_map_from_kv() {
  python3 - "$@" <<'PY'
import json
import sys

values = {}
for arg in sys.argv[1:]:
    if '=' not in arg:
        print(f"Bad arg (expected key=val): {arg}", file=sys.stderr)
        sys.exit(1)
    key, raw = arg.split('=', 1)
    if not key:
        print(f"Bad arg (empty key): {arg}", file=sys.stderr)
        sys.exit(1)

    try:
        value = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        try:
            value = int(raw)
        except ValueError:
            try:
                value = float(raw)
            except ValueError:
                value = raw

    values[key] = value

print(json.dumps(values))
PY
}

build_inputs_json() {
  local map_json
  map_json="$(json_map_from_kv "$@")"
  python3 - "$map_json" <<'PY'
import json
import sys
print(json.dumps({"inputs": json.loads(sys.argv[1])}))
PY
}

extract_first_use_case_id() {
  python3 - <<'PY'
import json
import sys

try:
    payload = json.loads(sys.stdin.read() or "{}")
except Exception:
    print("", end="")
    raise SystemExit(0)

use_cases = payload.get("use_cases")
if isinstance(use_cases, list) and use_cases and isinstance(use_cases[0], dict):
    print(str(use_cases[0].get("use_case_id") or ""), end="")
else:
    print("", end="")
PY
}

discover_use_case() {
  local objective="$1"
  local domain="${2:-}"
  local limit="${3:-5}"
  DISCOVERED_USE_CASE_ID=""

  local path="/api/v1/use-cases?limit=${limit}&q=$(urlencode "$objective")"
  if [[ -n "$domain" ]]; then
    path+="&domain=$(urlencode "$domain")"
  fi
  DISCOVER_USE_CASE_PATH="$path"

  call_api GET "$path"
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    DISCOVERED_USE_CASE_ID="$(printf '%s' "$API_BODY" | extract_first_use_case_id)"
    if [[ -n "$DISCOVERED_USE_CASE_ID" ]]; then
      return 0
    fi
  fi

  if [[ "$API_STATUS" == "401" || "$API_STATUS" == "403" ]]; then
    return 2
  fi

  return 1
}

require_value_flag() {
  local flag="$1"
  local maybe_value="${2:-}"
  if [[ -z "$maybe_value" ]]; then
    echo "Missing value for ${flag}" >&2
    exit 1
  fi
}

# ── Parse global flags first ──
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --url)
      require_value_flag "$1" "${2:-}"
      API_URL="$2"
      shift 2
      ;;
    --token)
      require_value_flag "$1" "${2:-}"
      TOKEN="$2"
      shift 2
      ;;
    --timeout)
      require_value_flag "$1" "${2:-}"
      REQUEST_TIMEOUT="$2"
      shift 2
      ;;
    --retry)
      require_value_flag "$1" "${2:-}"
      REQUEST_RETRIES="$2"
      shift 2
      ;;
    --jq)
      require_value_flag "$1" "${2:-}"
      JQ_FILTER="$2"
      shift 2
      ;;
    --profile)
      require_value_flag "$1" "${2:-}"
      PROFILE="$2"
      load_profile "$PROFILE"
      PROFILE_LOADED=1
      shift 2
      ;;
    --verbose|-v)
      VERBOSE=1
      shift
      ;;
    --raw)
      RAW=1
      shift
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ ${#args[@]} -gt 0 ]]; then
  set -- "${args[@]}"
else
  set --
fi

if ! [[ "$REQUEST_TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "--timeout must be an integer number of seconds" >&2
  exit 1
fi
if ! [[ "$REQUEST_RETRIES" =~ ^[0-9]+$ ]]; then
  echo "--retry must be an integer >= 0" >&2
  exit 1
fi
if (( REQUEST_RETRIES < 0 )); then
  echo "--retry must be >= 0" >&2
  exit 1
fi
if [[ -n "$JQ_FILTER" ]] && ! command -v jq >/dev/null 2>&1; then
  echo "--jq requires jq to be installed" >&2
  exit 1
fi
if [[ -n "$PROFILE" && -z "${PROFILE_LOADED:-}" ]]; then
  # DO_PROFILE env var (not yet sourced via --profile flag)
  load_profile "$PROFILE"
fi
PROFILE_LOADED=1

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

command="$1"
shift

# ═════════════════════════════════════════════════════════════════════
# health
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "health" ]]; then
  call_api GET "/health"
  ok_or_die "/health"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# tools (list)
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "tools" || "$command" == "list" ]]; then
  call_api GET "/api/v1/admin/list-tool-names"
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    print_body_stdout
    exit 0
  fi

  log "Falling back to /api/v1/tools?limit=200"
  call_api GET "/api/v1/tools?limit=200"
  ok_or_die "/api/v1/tools?limit=200"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# search "<query>" [--limit <n>] [--backend <id>]
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "search" ]]; then
  limit="10"
  backend=""
  query_parts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit)
        require_value_flag "$1" "${2:-}"
        limit="$2"
        shift 2
        ;;
      --backend)
        require_value_flag "$1" "${2:-}"
        backend="$2"
        shift 2
        ;;
      *)
        query_parts+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#query_parts[@]} -eq 0 ]]; then
    echo 'Usage: ./do search "<query>" [--limit <n>] [--backend <id>]' >&2
    exit 1
  fi
  if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
    echo "--limit must be an integer" >&2
    exit 1
  fi

  path="/api/v1/tools/search?q=$(urlencode "${query_parts[*]}")&limit=${limit}"
  [[ -n "$backend" ]] && path+="&backend=$(urlencode "$backend")"

  call_api GET "$path"
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    print_body_stdout
    exit 0
  fi

  log "Semantic search unavailable (status=${API_STATUS}); falling back to client-side catalog filter"
  call_api GET "/api/v1/tools?limit=500"
  if ! [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    die_api "/api/v1/tools?limit=500"
  fi

  API_BODY="$(printf '%s' "$API_BODY" | python3 -c "
import json, sys

query = sys.argv[1].lower()
limit = int(sys.argv[2])
terms = [t for t in query.replace(',', ' ').split() if t]

try:
    tools = json.loads(sys.stdin.read() or '[]')
except Exception:
    tools = []
if isinstance(tools, dict):
    tools = tools.get('tools', [])

def score(tool):
    name = str(tool.get('name', '')).lower()
    desc = str(tool.get('description', '')).lower()
    tags = ' '.join(str(t) for t in tool.get('tags', []) or []).lower()
    category = str(tool.get('category', '')).lower()
    s = 0.0
    for term in terms:
        if term == name:
            s += 10
        elif term in name:
            s += 5
        if term in desc:
            s += 2
        if term in tags:
            s += 3
        if term in category:
            s += 2
    return s

ranked = sorted(((score(t), t) for t in tools), key=lambda x: -x[0])
results = [
    {'name': t.get('name'), 'description': t.get('description'),
     'category': t.get('category'), 'tags': t.get('tags'), 'score': s}
    for s, t in ranked if s > 0
][:limit]
print(json.dumps({'query': query, 'mode': 'client_side_fallback',
                  'count': len(results), 'results': results}))
" "${query_parts[*]}" "$limit")"
  print_body_stdout
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# describe <tool>
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "describe" || "$command" == "info" ]]; then
  if [[ $# -lt 1 ]]; then
    echo "Usage: ./do describe <tool_name>" >&2
    exit 1
  fi

  tool="$1"
  call_api GET "/api/v1/tools/${tool}"
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    print_body_stdout
    exit 0
  fi

  log "Direct lookup failed (status=${API_STATUS}); falling back to catalog scan"
  call_api GET "/api/v1/tools?limit=500"
  if ! [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    die_api "/api/v1/tools?limit=500"
  fi

  match="$(printf '%s' "$API_BODY" | python3 -c "
import json, sys

name = sys.argv[1]
try:
    tools = json.loads(sys.stdin.read() or '[]')
except Exception:
    tools = []
if isinstance(tools, dict):
    tools = tools.get('tools', [])

for t in tools:
    if t.get('name') == name:
        print(json.dumps(t))
        break
" "$tool")"

  if [[ -z "$match" ]]; then
    echo "Tool not found: $tool" >&2
    echo "Try: ./do search \"$tool\"" >&2
    exit 1
  fi

  API_BODY="$match"
  print_body_stdout
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# doctor — composite connectivity/auth/capability diagnostics
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "doctor" ]]; then
  overall=0

  check() {
    local label="$1"
    local path="$2"
    local extract="${3:-}"
    local t0 t1 elapsed_ms detail

    t0=$(python3 -c 'import time; print(int(time.time()*1000))')
    call_api GET "$path"
    t1=$(python3 -c 'import time; print(int(time.time()*1000))')
    elapsed_ms=$((t1 - t0))

    if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
      detail=""
      if [[ -n "$extract" ]]; then
        detail="$(printf '%s' "$API_BODY" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read() or '{}')
    print($extract)
except Exception:
    print('')
" 2>/dev/null || true)"
      fi
      printf '  ✓ %-24s %4s  %5sms  %s\n' "$label" "$API_STATUS" "$elapsed_ms" "$detail"
    else
      printf '  ✗ %-24s %4s  %5sms\n' "$label" "${API_STATUS:-000}" "$elapsed_ms"
      overall=1
    fi
  }

  echo "do doctor — $API_URL"
  echo
  echo "Local environment:"
  for dep in curl python3 jq; do
    if command -v "$dep" >/dev/null 2>&1; then
      printf '  ✓ %-24s %s\n' "$dep" "$(command -v "$dep")"
    else
      printf '  ✗ %-24s not found%s\n' "$dep" "$([[ "$dep" == "jq" ]] && echo ' (optional; used for pretty output and --jq)')"
      [[ "$dep" != "jq" ]] && overall=1
    fi
  done
  if [[ -n "$TOKEN" ]]; then
    printf '  ✓ %-24s set (%s chars)\n' "auth token" "${#TOKEN}"
  else
    printf '  - %-24s not set\n' "auth token"
  fi
  echo
  echo "API endpoints:"
  check "health" "/health"
  check "tool registry" "/api/v1/admin/list-tool-names" "f\"{len(d.get('tool_names', d.get('tools', [])))} tools\""
  check "orchestration" "/api/v1/orchestration/health"
  check "jobs" "/api/v1/jobs/analytics" "f\"{d.get('analytics', {}).get('totals', {}).get('executions', 0)} executions in window\""
  check "compose patterns" "/compose/patterns" "f\"{len(d.get('patterns', []))} patterns\""
  check "use cases" "/api/v1/use-cases?limit=1" "f\"{d.get('count', len(d.get('use_cases', [])))} available\""

  echo
  if [[ "$overall" == "0" ]]; then
    echo "All checks passed."
  else
    echo "Some checks failed — inspect with --verbose or ./do <cmd> --raw." >&2
  fi
  exit "$overall"
fi

# ═════════════════════════════════════════════════════════════════════
# exec <tool> [key=val ...]
# Optional advanced controls: --mode --timeout-ms --priority
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "exec" || "$command" == "execute" ]]; then
  if [[ $# -lt 1 ]]; then
    echo "Usage: ./do exec <tool_name> [key=val ...] [--mode <auto|sync|stream|job>] [--timeout-ms <ms>] [--priority <p0|p1|p2|p3>]" >&2
    exit 1
  fi

  tool="$1"
  shift

  mode=""
  timeout_ms=""
  priority=""
  kv_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)
        require_value_flag "$1" "${2:-}"
        mode="$2"
        shift 2
        ;;
      --timeout-ms)
        require_value_flag "$1" "${2:-}"
        timeout_ms="$2"
        shift 2
        ;;
      --priority)
        require_value_flag "$1" "${2:-}"
        priority="$2"
        shift 2
        ;;
      *)
        kv_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$mode$timeout_ms$priority" ]]; then
    payload="$(build_inputs_json "${kv_args[@]}")"
    call_api POST "/api/v1/tools/${tool}/execute" "$payload"
    ok_or_die "/api/v1/tools/${tool}/execute"
    exit 0
  fi

  if [[ -n "$timeout_ms" && ! "$timeout_ms" =~ ^[0-9]+$ ]]; then
    echo "--timeout-ms must be an integer" >&2
    exit 1
  fi

  args_json="$(json_map_from_kv "${kv_args[@]}")"
  payload="$(python3 - "$tool" "$args_json" "$mode" "$timeout_ms" "$priority" <<'PY'
import json
import sys

payload = {
    "tool_name": sys.argv[1],
    "arguments": json.loads(sys.argv[2]),
    "stream": False,
}
if sys.argv[3]:
    payload["execution_mode"] = sys.argv[3]
if sys.argv[4]:
    payload["timeout_ms"] = int(sys.argv[4])
if sys.argv[5]:
    payload["priority"] = sys.argv[5]

print(json.dumps(payload))
PY
)"

  call_api POST "/api/v1/execute" "$payload"
  ok_or_die "/api/v1/execute"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# batch <tool1> k=v ... -- <tool2> k=v ...
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "batch" ]]; then
  if [[ $# -lt 1 ]]; then
    echo "Usage: ./do batch <tool> k=v -- <tool2> k=v ..." >&2
    exit 1
  fi

  calls_json="$(python3 -c "
import json, sys

raw = sys.argv[1:]
groups = []
current = []
for tok in raw:
    if tok == '--':
        if current:
            groups.append(current)
        current = []
    else:
        current.append(tok)
if current:
    groups.append(current)

calls = []
for g in groups:
    tool_name = g[0]
    inputs = {}
    for arg in g[1:]:
        if '=' not in arg:
            print(f'Bad arg: {arg}', file=sys.stderr)
            sys.exit(1)
        k, v = arg.split('=', 1)
        try:
            v = json.loads(v)
        except (json.JSONDecodeError, ValueError):
            try:
                v = int(v)
            except ValueError:
                try:
                    v = float(v)
                except ValueError:
                    pass
        inputs[k] = v
    calls.append({'tool': tool_name, 'inputs': inputs})

print(json.dumps({'calls': calls, 'parallel': True}))
" "$@")"

  call_api POST "/api/v1/batch" "$calls_json" 60
  if [[ "$API_STATUS" =~ ^2[0-9][0-9]$ ]]; then
    print_body_stdout
    exit 0
  fi

  log "Batch endpoint unavailable; fanning out individual calls"
  API_URL="$API_URL" TOKEN="$TOKEN" python3 -c "
import asyncio, json, os, sys, time

try:
    import httpx
    HAS_HTTPX = True
except ImportError:
    import urllib.request, urllib.error
    HAS_HTTPX = False

calls = json.loads(sys.argv[1])['calls']
api_url = os.environ['API_URL']
token = os.environ.get('TOKEN', '')

async def run_httpx():
    headers = {'content-type': 'application/json'}
    if token:
        headers['authorization'] = f'Bearer {token}'
    async with httpx.AsyncClient(timeout=60) as client:
        async def one(c):
            t0 = time.time()
            url = f\"{api_url}/api/v1/tools/{c['tool']}/execute\"
            try:
                r = await client.post(url, json={'inputs': c['inputs']}, headers=headers)
                data = r.json()
                data['latency_ms'] = round((time.time() - t0) * 1000, 1)
                return data
            except Exception as e:
                return {'tool': c['tool'], 'status': 'error', 'error': str(e),
                        'latency_ms': round((time.time() - t0) * 1000, 1)}
        return await asyncio.gather(*[one(c) for c in calls])

def run_urllib():
    results = []
    for c in calls:
        t0 = time.time()
        url = f\"{api_url}/api/v1/tools/{c['tool']}/execute\"
        body = json.dumps({'inputs': c['inputs']}).encode()
        req = urllib.request.Request(url, data=body, method='POST',
                                     headers={'content-type': 'application/json'})
        if token:
            req.add_header('authorization', f'Bearer {token}')
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read())
                data['latency_ms'] = round((time.time() - t0) * 1000, 1)
                results.append(data)
        except Exception as e:
            results.append({'tool': c['tool'], 'status': 'error', 'error': str(e),
                            'latency_ms': round((time.time() - t0) * 1000, 1)})
    return results

t_start = time.time()
if HAS_HTTPX:
    results = asyncio.run(run_httpx())
else:
    results = run_urllib()
results = list(results)
successful = sum(1 for r in results if r.get('status') == 'success')
print(json.dumps({
    'results': results,
    'total': len(results),
    'successful': successful,
    'failed': len(results) - successful,
    'total_latency_ms': round((time.time() - t_start) * 1000, 1),
}, indent=2))
" "$calls_json"
  exit 0
fi

# ═════════════════════════════════════════════════════════════════════
# pipe <t1> k=v -- <t2> ... [--in k=v ...] [--stream]
# Server-side sequential composition: output of each tool feeds the next.
# ═════════════════════════════════════════════════════════════════════
if [[ "$command" == "pipe" || "$command" == "seq" ]]; then
  stream=0
  initial_inputs=()
  group_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stream)
        stream=1
        shift
        ;;
      --in)
        require_value_flag "$1" "${2:-}"
        initial_inputs+=("$2")
        shift 2
        ;;
      *)
        group_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#group_args[@]} -eq 0 ]]; then
    echo 'Usage: ./do pipe <tool1> k=v -- <tool2> ... [--in k=v ...] [--stream]' >&2
    exit 1
  fi

  groups_json="$(parse_tool_groups "${group_args[@]}")"
  inputs_json="$(json_map_from_kv ${initial_inputs[@]+"${initial_inputs[@]}"})"
  payload="$(python3 - "$groups_json" "$inputs_json" <<'PY'
import json
import sys
groups = json.loads(sys.argv[1])
groups["inputs"] = json.loads(sys.argv[2])
print(json.dumps(groups))
PY
)"

  if [[ "$stream" == "1" ]]; then
    if sse_stream POST "/compose/seq/stream" "$payload"; then
      exit 0
    fi
    log "Streaming failed; falling back to blocking /compose/seq"
  fi

  call_api POST "/compose/seq" "$payload" 120
  ok_or_die "/compose/seq"
  exit 0
fi

