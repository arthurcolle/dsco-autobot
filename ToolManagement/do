        require_value_flag "$1" "${2:-}"
        initial_inputs+=("$2")
        shift 2
        ;;
      *)
        group_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#group_args[@]} -eq 0 ]]; then
    echo 'Usage: ./do fork <tool1> k=v -- <tool2> ... [--join merge|array|first] [--stream]' >&2
    exit 1
  fi
  case "$join_strategy" in
    merge|array|first) ;;
    *)
      echo "--join must be one of: merge, array, first" >&2
      exit 1
      ;;
  esac

  groups_json="$(parse_tool_groups "${group_args[@]}")"
  inputs_json="$(json_map_from_kv ${initial_inputs[@]+"${initial_inputs[@]}"})"
  payload="$(python3 - "$groups_json" "$inputs_json" "$join_strategy" <<'PY'
import json
import sys
groups = json.loads(sys.argv[1])
groups["inputs"] = json.loads(sys.argv[2])
groups["join_strategy"] = sys.argv[3]
print(json.dumps(groups))
PY
)"

  if [[ "$stream" == "1" ]]; then
    if sse_stream POST "/compose/fork/stream" "$payload"; then
      exit 0
    fi
    log "Streaming failed; falling back to blocking /compose/fork"
  fi

  call_api POST "/compose/fork" "$payload" 120
  ok_or_die "/compose/fork"
