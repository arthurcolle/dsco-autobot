        "incident_timeline",
        "event_stream",
        "operator_notes"
      ],
      "economic_hooks": [
        "max_total_cost_cents",
        "max_reintegration_cost",
        "callback_events"
      ],
      "risk_controls": [
        "queue_backpressure",
        "priority_control",
        "fast_fail_errors"
      ],
      "defaults": {
        "incident_query": "regional outage status",
        "severity": "high"
      },
      "default_template": "default",
      "templates": {
        "default": {
          "execution": "parallel",
          "dedupe_calls": true,
          "max_parallel": 6,
          "auto_tune_parallel": true,
          "max_reintegration_cost": 8.0,
          "reintegration_overflow_policy": "truncate",
          "max_total_cost_cents": 220,
          "calls": [
            {
              "tool_name": "search",
              "execution_mode": "stream",
              "arguments": {
                "query": "{{incident_query}}",
                "num_results": 12,
                "sort": "latest"
              },
              "priority": "p0"
            },
            {
              "tool_name": "read",
              "execution_mode": "auto",
              "arguments": {
                "query": "{{incident_query}}"
              },
              "priority": "p0"
            },
            {
              "tool_name": "publish_event",
              "execution_mode": "auto",
              "arguments": {
                "event_type": "incident.update",
                "severity": "{{severity}}",
                "summary": "{{objective}}"
              },
              "idempotency_key": "incident:update:{{incident_query}}:{{today_utc}}"
            }
          ]
        }
      }
