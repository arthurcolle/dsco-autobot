{
  "version": "2026-02-23",
  "use_cases": [
    {
      "use_case_id": "market_intel_compound_briefing",
      "title": "Market Intelligence Compound Briefing",
      "domain": "market_intelligence",
      "summary": "Continuously harvest market signals, synthesize them, and persist durable beliefs for agent memory.",
      "objective": "Generate a reliable daily strategic market brief with traceable evidence.",
      "tags": ["market", "research", "memory", "agents"],
      "outcomes": [
        "Fresh cross-source briefing",
        "Persisted thesis updates",
        "Reduced repeated deep-search cost"
      ],
      "data_assets": [
        "search_result_cache",
        "source_extracts",
        "synthesized_briefs",
        "belief_embeddings"
      ],
      "economic_hooks": [
        "max_total_cost_cents",
        "max_reintegration_cost",
        "idempotency_key",
        "auto_follow_up"
      ],
      "risk_controls": [
        "admission_check",
        "batch_plan_preflight",
        "reintegration_policy",
        "durable_follow_ups"
      ],
      "defaults": {
        "query": "distributed systems market outlook",
        "segment": "infrastructure and autonomy",
        "num_results": 8,
        "deep_num_results": 18
      },
      "default_template": "default",
      "templates": {
        "default": {
          "execution": "parallel",
          "dedupe_calls": true,
          "dedupe_on_tool": true,
          "auto_tune_parallel": true,
          "max_parallel": 8,
          "max_reintegration_cost": 12.0,
          "reintegration_overflow_policy": "truncate",
          "max_total_cost_cents": 380,
          "calls": [
            {
              "tool_name": "search",
              "execution_mode": "auto",
              "arguments": {
                "query": "{{query}}",
                "segment": "{{segment}}",
                "num_results": "{{num_results}}"
              }
            },
            {
              "tool_name": "deep_search",
              "execution_mode": "job",
              "arguments": {
                "query": "{{query}}",
                "num_results": "{{deep_num_results}}",
                "mode": "thorough"
              }
            },
            {
              "tool_name": "synthesize",
              "execution_mode": "auto",
              "arguments": {
                "topic": "{{query}}",
                "style": "executive"
              }
            },
            {
              "tool_name": "store_belief",
              "execution_mode": "auto",
              "arguments": {
                "belief": "{{objective}}",
                "source": "market_intel_compound_briefing"
              },
              "idempotency_key": "belief:{{query}}:{{today_utc}}"
            }
          ]
        },
        "quick": {
          "execution": "parallel",
          "dedupe_calls": true,
          "max_parallel": 4,
          "max_reintegration_cost": 6.0,
          "reintegration_overflow_policy": "truncate",
          "max_total_cost_cents": 150,
          "calls": [
            {
              "tool_name": "search",
              "execution_mode": "auto",
              "arguments": {
                "query": "{{query}}",
                "num_results": 5
              }
            },
            {
              "tool_name": "synthesize",
              "execution_mode": "auto",
              "arguments": {
                "topic": "{{query}}",
                "style": "brief"
              }
            }
          ]
        }
      }
    },
    {
      "use_case_id": "incident_response_live_ops",
      "title": "Incident Response Live Ops",
      "domain": "operations",
      "summary": "Run real-time incident triage with streaming search and event publication while maintaining cost controls.",
