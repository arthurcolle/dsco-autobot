# Parallel API Configuration
API_KEY=your_parallel_api_key_here
API_BASE_URL=https://api.parallel.ai
API_VERSION=v1
PARALLEL_BETA_HEADER=search-extract-2025-10-10
API_KEY_CACHE_FILE=.parallel_api_key

# Server Configuration
HOST=127.0.0.1
PORT=2040
RELOAD=false
WORKERS=4
LOG_LEVEL=info
ENVIRONMENT=development

# Request Configuration
REQUEST_TIMEOUT=300
MAX_CONCURRENT_REQUESTS=100

# Streaming Configuration
STREAM_CHUNK_SIZE=1024
STREAM_TIMEOUT=600
STREAM_HEARTBEAT_INTERVAL=30

# MCP Configuration
MCP_HTTP_PATH=/mcp
MCP_SSE_PATH=/mcp/sse
